{
  "_HOW_TO_FILL_THIS_IN": [
    "Copy this file to `local.settings.json` in the same folder (the copy is gitignored).",
    "AZURE_AI_AGENT_ENDPOINT: Foundry portal -> project -> ... -> Project properties -> endpoint URL.",
    "AZURE_AI_AGENT_SUBSCRIPTION_ID / RESOURCE_GROUP_NAME / PROJECT_NAME: Foundry portal -> project -> Management center -> Resources.",
    "AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME: Foundry portal -> Models + endpoints -> 'Deployment name' column (e.g. gpt-5.4). NOT the model name.",
    "CATEGORIZATION_AGENT_ID / GROUPING_AGENT_ID / FOLLOWUP_AGENT_ID: Foundry portal -> Agents -> open agent -> copy asst_... ID. All three should be on the gpt-5.4 deployment.",
    "REGULATIONS_GOV_API_KEY: request at https://open.gsa.gov/api/regulationsgov/ (api.data.gov issues the key, sent as X-Api-Key header).",
    "AZURE_STORAGE_ACCOUNT_NAME: only needed if writing output blobs to a storage account; leave blank otherwise."
  ],
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "REGULATIONS_GOV_API_KEY": "your_regulations_gov_api_key_here",
    "DOCUMENT_ID": "ED-2025-SCC-0481-0001",
    "CATEGORIZATION_AGENT_ID": "asst_your_categorization_agent_id",
    "GROUPING_AGENT_ID": "asst_your_grouping_agent_id",
    "FOLLOWUP_AGENT_ID": "asst_your_followup_agent_id",
    "BATCH_SIZE": "5",
    "MAX_COMMENTS": "",
    "AZURE_STORAGE_ACCOUNT_NAME": "your_storage_account_name",
    "AZURE_AI_PROJECT_CONNECTION_STRING": "your_azure_ai_project_connection_string",
    "AZURE_AI_PROJECT_ENDPOINT": "your_azure_ai_project_endpoint",
    "AZURE_AI_AGENT_ENDPOINT": "https://your-resource.services.ai.azure.com/api/projects/your-project",
    "AZURE_AI_AGENT_SUBSCRIPTION_ID": "your-subscription-id-here",
    "AZURE_AI_AGENT_RESOURCE_GROUP_NAME": "your-resource-group-name",
    "AZURE_AI_AGENT_PROJECT_NAME": "your-project-name",
    "AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME": "gpt-5.4"
  }
}
