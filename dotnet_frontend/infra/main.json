{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "10591197351354184963"
    }
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "defaultValue": "doedweb",
      "minLength": 3,
      "maxLength": 15,
      "metadata": {
        "description": "Three-to-fifteen-char base name used to compose all resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Preferred: eastus2. Some subscriptions have no dedicated App Service (B1+) quota in eastus2 — use centralus as the fallback. Verify with: az deployment group what-if."
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "P0v3",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "P0v3",
        "P1v3",
        "P2v3"
      ],
      "metadata": {
        "description": "SKU for the Linux App Service Plan. P0v3 is the production default."
      }
    },
    "regulationsGovApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "The Regulations.gov v4 API key. Stored as a Key Vault secret and consumed by the app via KV reference."
      }
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Foundry project endpoint, e.g. https://<name>.services.ai.azure.com/api/projects/<project>. Obtain from the Foundry portal: project -> \"...\" menu -> Project properties -> endpoint."
      }
    },
    "useKeyVaultReferences": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Wire the API key and Foundry endpoint into app settings as Key Vault references. Set false when tenant policy forces publicNetworkAccess=Disabled on Key Vault and the app has no private endpoint to reach it; the values are then written directly to app settings, which App Service still encrypts at rest."
      }
    },
    "categorizationAgentName": {
      "type": "string",
      "defaultValue": "RegulatoryCommentCategorizationAgent",
      "metadata": {
        "description": "Foundry prompt-agent NAME for per-comment categorization (no asst_… ID — this is the agent label visible in the Foundry Agents list)."
      }
    },
    "categorizationAgentVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Foundry prompt-agent version for the categorization agent. Use \"latest\" to always pick the currently published version."
      }
    },
    "groupingAgentName": {
      "type": "string",
      "defaultValue": "RegulatoryCommentGroupingAgent",
      "metadata": {
        "description": "Foundry prompt-agent NAME for theme grouping + collective analysis."
      }
    },
    "groupingAgentVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Foundry prompt-agent version for the grouping agent."
      }
    },
    "validationAgentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Foundry prompt-agent NAME for validating grouped analysis. Optional; pass an empty string to skip validation."
      }
    },
    "validationAgentVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Foundry prompt-agent version for the validation agent."
      }
    },
    "followUpAgentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Foundry prompt-agent NAME for the follow-up Q&A chat. Optional — pass empty string to disable."
      }
    },
    "followUpAgentVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Foundry prompt-agent version for the follow-up agent."
      }
    },
    "modelDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-5.5",
      "metadata": {
        "description": "Foundry model deployment name backing the agents (informational only — the prompt agent picks its own model in the portal)."
      }
    },
    "defaultDocumentId": {
      "type": "string",
      "defaultValue": "ED-2025-SCC-0481-0001",
      "metadata": {
        "description": "Default Regulations.gov document ID the UI pre-fills."
      }
    },
    "batchSize": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 1,
      "maxValue": 20,
      "metadata": {
        "description": "Default batch size sent to the grouping agent (1-20)."
      }
    },
    "useFunctionAnalysisBackend": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Delegate analysis execution to the Azure Function instead of running Foundry agents in the web app."
      }
    },
    "analysisFunctionBaseUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Base HTTPS URL of the analysis Function App, for example https://func-example.azurewebsites.net/."
      }
    },
    "analysisFunctionKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Function host or function key used by the server-side web app."
      }
    },
    "persistenceProvider": {
      "type": "string",
      "defaultValue": "Sqlite",
      "allowedValues": [
        "Sqlite",
        "AzureSql",
        "Cosmos"
      ],
      "metadata": {
        "description": "Analysis history backend. Sqlite is local/persistent App Service storage; AzureSql and Cosmos point to existing Azure resources."
      }
    },
    "analysisDbConnectionString": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Azure SQL connection string. Prefer Authentication=Active Directory Default so the App Service managed identity is used."
      }
    },
    "cosmosEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Cosmos DB account endpoint used with the App Service managed identity."
      }
    },
    "cosmosDatabaseName": {
      "type": "string",
      "defaultValue": "doed-regulatory-comments",
      "metadata": {
        "description": "Cosmos DB database containing analysis-run documents."
      }
    },
    "cosmosContainerName": {
      "type": "string",
      "defaultValue": "analysis-runs",
      "metadata": {
        "description": "Cosmos DB container for analysis runs. Its partition key must be /id."
      }
    },
    "cosmosCreateIfNotExists": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Create the Cosmos database/container on startup. Leave false when infrastructure provisions them."
      }
    },
    "provisionCosmosResources": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Provision a serverless Cosmos account, database, aggregate container, and summary container in this template."
      }
    },
    "cosmosAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional name for a provisioned Cosmos account. A globally unique name is generated when blank."
      }
    },
    "cosmosSummaryContainerName": {
      "type": "string",
      "defaultValue": "analysis-run-summaries",
      "metadata": {
        "description": "Cosmos summary container partitioned by normalized document ID."
      }
    },
    "workspaceContainerName": {
      "type": "string",
      "defaultValue": "analyst-workspace",
      "metadata": {
        "description": "Workspace container for reviews, watchlists, saved views, and persistent notifications; partition /id."
      }
    },
    "cosmosResourceGroupName": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group containing an existing Cosmos account. Defaults to this deployment resource group."
      }
    },
    "enableDocketMonitoring": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable periodic docket checks in the always-on web app."
      }
    },
    "monitoringIntervalMinutes": {
      "type": "int",
      "defaultValue": 60,
      "minValue": 1,
      "maxValue": 1440
    },
    "allowedClientNetworks": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional client IPv4/IPv6 CIDRs allowed to reach the web app. Empty preserves public access."
      }
    },
    "enablePayloadStorage": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Provision private Blob Storage for oversized analysis payloads."
      }
    },
    "analysisPayloadBlobContainerUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing Blob container URI used for oversized analysis payloads. Takes precedence over frontend-provisioned payload storage."
      }
    },
    "payloadOffloadThresholdBytes": {
      "type": "int",
      "defaultValue": 524288,
      "minValue": 65536,
      "maxValue": 1572864,
      "metadata": {
        "description": "Offload raw categorization payloads to Blob Storage after this many UTF-8 bytes."
      }
    },
    "enableAttachmentOcr": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Provision Azure AI Document Intelligence for scanned-PDF OCR."
      }
    },
    "foundryInputUsdPerMillionTokens": {
      "type": "string",
      "defaultValue": "0",
      "metadata": {
        "description": "Estimated Foundry input-token price in USD per million tokens. Used only for telemetry."
      }
    },
    "foundryOutputUsdPerMillionTokens": {
      "type": "string",
      "defaultValue": "0",
      "metadata": {
        "description": "Estimated Foundry output-token price in USD per million tokens. Used only for telemetry."
      }
    },
    "alertEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional operations email address for Azure Monitor alert notifications."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "doed-regulatory-comments-web",
        "managedBy": "bicep"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(subscription().subscriptionId, resourceGroup().id, parameters('baseName'))]",
    "logAnalyticsName": "[format('{0}-law-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "appInsightsName": "[format('{0}-appi-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "keyVaultName": "[take(format('{0}kv{1}', parameters('baseName'), variables('uniqueSuffix')), 24)]",
    "planName": "[format('{0}-plan-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "appName": "[format('{0}-app-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "payloadStorageName": "[take(format('{0}pay{1}', replace(parameters('baseName'), '-', ''), variables('uniqueSuffix')), 24)]",
    "payloadContainerName": "analysis-run-payloads",
    "documentIntelligenceName": "[take(format('{0}-ocr-{1}', parameters('baseName'), variables('uniqueSuffix')), 64)]",
    "provisionedCosmosAccountName": "[if(empty(parameters('cosmosAccountName')), take(format('{0}cosmos{1}', replace(parameters('baseName'), '-', ''), variables('uniqueSuffix')), 44), parameters('cosmosAccountName'))]",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "cognitiveServicesUserRoleId": "a97b65f3-24c7-4388-baec-2e87135dc908",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "kvRefRegsApiKey": "[format('@Microsoft.KeyVault(VaultName={0};SecretName={1})', variables('keyVaultName'), 'RegulationsGov-ApiKey')]",
    "kvRefFoundryEndpoint": "[format('@Microsoft.KeyVault(VaultName={0};SecretName={1})', variables('keyVaultName'), 'Foundry-ProjectEndpoint')]",
    "sqliteConnectionString": "Data Source=/home/data/analysis.db",
    "payloadContainerUri": "[if(not(empty(parameters('analysisPayloadBlobContainerUri'))), parameters('analysisPayloadBlobContainerUri'), if(parameters('enablePayloadStorage'), format('https://{0}.blob.{1}/{2}', variables('payloadStorageName'), environment().suffixes.storage, variables('payloadContainerName')), ''))]",
    "alertActions": "[if(empty(parameters('alertEmail')), createArray(), createArray(createObject('actionGroupId', resourceId('Microsoft.Insights/actionGroups', format('{0}-operations', parameters('baseName'))))))]"
  },
  "resources": {
    "logAnalytics": {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    "appInsights": {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      },
      "dependsOn": [
        "logAnalytics"
      ]
    },
    "keyVault": {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-04-01-preview",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    "secretRegsApiKey": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-04-01-preview",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'RegulationsGov-ApiKey')]",
      "properties": {
        "value": "[parameters('regulationsGovApiKey')]",
        "contentType": "text/plain"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "secretFoundryEndpoint": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-04-01-preview",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'Foundry-ProjectEndpoint')]",
      "properties": {
        "value": "[parameters('foundryProjectEndpoint')]",
        "contentType": "text/plain"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "appServicePlan": {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('appServicePlanSku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    "webApp": {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'web'))]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "copy": [
            {
              "name": "ipSecurityRestrictions",
              "count": "[length(parameters('allowedClientNetworks'))]",
              "input": {
                "name": "[format('allowed-client-{0}', copyIndex('ipSecurityRestrictions'))]",
                "ipAddress": "[parameters('allowedClientNetworks')[copyIndex('ipSecurityRestrictions')]]",
                "action": "Allow",
                "priority": "[add(100, copyIndex('ipSecurityRestrictions'))]"
              }
            }
          ],
          "linuxFxVersion": "DOTNETCORE|9.0",
          "alwaysOn": true,
          "ipSecurityRestrictionsDefaultAction": "[if(empty(parameters('allowedClientNetworks')), 'Allow', 'Deny')]",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "healthCheckPath": "/health/ready"
        }
      },
      "dependsOn": [
        "appServicePlan"
      ]
    },
    "payloadStorage": {
      "condition": "[parameters('enablePayloadStorage')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('payloadStorageName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowCrossTenantReplication": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "minimumTlsVersion": "TLS1_2",
        "publicNetworkAccess": "Enabled",
        "supportsHttpsTrafficOnly": true
      }
    },
    "payloadBlobService": {
      "condition": "[parameters('enablePayloadStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('payloadStorageName'), 'default')]",
      "properties": {
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        },
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      },
      "dependsOn": [
        "payloadStorage"
      ]
    },
    "payloadContainer": {
      "condition": "[parameters('enablePayloadStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('payloadStorageName'), 'default', variables('payloadContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "payloadBlobService"
      ]
    },
    "payloadStorageRoleAssignment": {
      "condition": "[parameters('enablePayloadStorage')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('payloadStorageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('payloadStorageName')), resourceId('Microsoft.Web/sites', variables('appName')), variables('storageBlobDataContributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[reference('webApp', '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "payloadStorage",
        "webApp"
      ]
    },
    "documentIntelligence": {
      "condition": "[parameters('enableAttachmentOcr')]",
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('documentIntelligenceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "FormRecognizer",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('documentIntelligenceName')]",
        "disableLocalAuth": true,
        "networkAcls": {
          "defaultAction": "Allow",
          "ipRules": [],
          "virtualNetworkRules": []
        },
        "publicNetworkAccess": "Enabled"
      }
    },
    "documentIntelligenceRoleAssignment": {
      "condition": "[parameters('enableAttachmentOcr')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('documentIntelligenceName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('documentIntelligenceName')), resourceId('Microsoft.Web/sites', variables('appName')), variables('cognitiveServicesUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRoleId'))]",
        "principalId": "[reference('webApp', '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "documentIntelligence",
        "webApp"
      ]
    },
    "cosmosAccount": {
      "condition": "[parameters('provisionCosmosResources')]",
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-05-15",
      "name": "[variables('provisionedCosmosAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "databaseAccountOfferType": "Standard",
        "disableLocalAuth": true,
        "locations": [
          {
            "failoverPriority": 0,
            "isZoneRedundant": false,
            "locationName": "[parameters('location')]"
          }
        ],
        "publicNetworkAccess": "Enabled"
      }
    },
    "cosmosDatabase": {
      "condition": "[parameters('provisionCosmosResources')]",
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}', variables('provisionedCosmosAccountName'), parameters('cosmosDatabaseName'))]",
      "properties": {
        "options": {},
        "resource": {
          "id": "[parameters('cosmosDatabaseName')]"
        }
      },
      "dependsOn": [
        "cosmosAccount"
      ]
    },
    "cosmosRunContainer": {
      "condition": "[parameters('provisionCosmosResources')]",
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}/{2}', variables('provisionedCosmosAccountName'), parameters('cosmosDatabaseName'), parameters('cosmosContainerName'))]",
      "properties": {
        "options": {},
        "resource": {
          "id": "[parameters('cosmosContainerName')]",
          "indexingPolicy": {
            "automatic": true,
            "excludedPaths": [
              {
                "path": "/categorizations/[]/rawResponse/?"
              },
              {
                "path": "/categorizations/[]/parsedJson/?"
              },
              {
                "path": "/followUpHistory/[]/text/?"
              }
            ],
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "indexingMode": "consistent"
          },
          "partitionKey": {
            "kind": "Hash",
            "paths": [
              "/id"
            ],
            "version": 2
          }
        }
      },
      "dependsOn": [
        "cosmosDatabase"
      ]
    },
    "cosmosSummaryContainer": {
      "condition": "[parameters('provisionCosmosResources')]",
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}/{2}', variables('provisionedCosmosAccountName'), parameters('cosmosDatabaseName'), parameters('cosmosSummaryContainerName'))]",
      "properties": {
        "options": {},
        "resource": {
          "id": "[parameters('cosmosSummaryContainerName')]",
          "indexingPolicy": {
            "automatic": true,
            "compositeIndexes": [
              [
                {
                  "path": "/type",
                  "order": "ascending"
                },
                {
                  "path": "/startedAt",
                  "order": "descending"
                }
              ],
              [
                {
                  "path": "/type",
                  "order": "ascending"
                },
                {
                  "path": "/succeeded",
                  "order": "ascending"
                },
                {
                  "path": "/startedAt",
                  "order": "descending"
                }
              ]
            ],
            "excludedPaths": [
              {
                "path": "/*"
              }
            ],
            "includedPaths": [
              {
                "path": "/type/?"
              },
              {
                "path": "/documentIdNormalized/?"
              },
              {
                "path": "/startedAt/?"
              },
              {
                "path": "/succeeded/?"
              }
            ],
            "indexingMode": "consistent"
          },
          "partitionKey": {
            "kind": "Hash",
            "paths": [
              "/documentIdNormalized"
            ],
            "version": 2
          }
        }
      },
      "dependsOn": [
        "cosmosDatabase"
      ]
    },
    "cosmosDataContributor": {
      "condition": "[parameters('provisionCosmosResources')]",
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
      "apiVersion": "2024-05-15",
