@page "/library"
@rendermode InteractiveServer
@using System.Text
@inject IAnalysisRepository Repo
@inject AnalysisStore Store
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Library</PageTitle>

<header class="page-header">
    <span class="section-eyebrow">History</span>
    <h1 class="page-header__title">Saved Analysis Runs</h1>
    <p class="page-header__meta">
        Every analysis run is persisted automatically. Give runs memorable names, search for them,
        reopen their themes, or resume the follow-up chat.
    </p>
</header>

<section class="surface-card mb-3">
    <div class="library-filters">
        <div class="library-filters__field">
            <label class="form-label small mb-1" for="librarySearch">Session name or document ID</label>
            <input id="librarySearch" class="form-control form-control-sm" @bind="_searchFilter" @bind:event="oninput" placeholder="e.g. IDEA oversight" />
        </div>
        <div class="library-filters__field library-filters__field--check">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="successOnly" @bind="_successOnly" />
                <label class="form-check-label" for="successOnly">Successful only</label>
            </div>
        </div>
        <div class="library-filters__field library-filters__field--actions">
            <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@_loading">Refresh</button>
        </div>
    </div>
</section>

@if (_loading)
{
    <div class="alert alert-light border">Loading…</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger"><strong>Couldn't load runs.</strong> @_error</div>
}
else if (Filtered.Count == 0)
{
    <div class="alert alert-light border">
        <strong>No runs yet.</strong> Run an analysis on the
        <a href="analysis">AI Analysis page</a> and it will appear here.
    </div>
}
else
{
    <section class="surface-card library-table-card">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 library-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Started</th>
                        <th>Document</th>
                        <th class="text-end">Comments</th>
                        <th class="text-end">Themes</th>
                        <th>Status</th>
                        <th>Sentiment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtered)
                    {
                        <tr class="library-row" @onclick="() => OpenRun(r.Id)" style="cursor:pointer">
                            <td class="library-session-name" @onclick:stopPropagation>
                                @if (_editingId == r.Id)
                                {
                                    <form class="session-name-editor" @onsubmit="() => SaveName(r)" @onsubmit:preventDefault>
                                        <input class="form-control form-control-sm" aria-label="Session name"
                                               maxlength="@AnalysisSessionNames.MaxLength" @bind="_editName" @bind:event="oninput" />
                                        <div class="session-name-editor__actions">
                                            <button class="btn btn-sm btn-primary" type="submit" disabled="@(_busyId == r.Id)">Save</button>
                                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelRename">Cancel</button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <span class="@(string.IsNullOrWhiteSpace(r.SessionName) ? "session-name session-name--untitled" : "session-name")">
                                        @(string.IsNullOrWhiteSpace(r.SessionName) ? "Untitled analysis" : r.SessionName)
                                    </span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <div>@r.StartedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                                @if (r.CompletedAt is { } done)
                                {
                                    var elapsed = done - r.StartedAt;
                                    <div class="small text-muted">@FormatElapsed(elapsed)</div>
                                }
                            </td>
                            <td><code>@r.DocumentId</code></td>
                            <td class="text-end">@r.TotalComments</td>
                            <td class="text-end">@r.ThemeCount</td>
                            <td>
                                @if (r.Succeeded)
                                {
                                    <span class="badge bg-success">Succeeded</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" title="@r.ErrorMessage">Failed</span>
                                }
                            </td>
                            <td><span class="small text-muted">@(string.IsNullOrWhiteSpace(r.OverallSentiment) ? "—" : r.OverallSentiment)</span></td>
                            <td class="text-end text-nowrap" @onclick:stopPropagation>
                                <button class="btn btn-sm btn-primary me-1"
                                        @onclick="() => OpenRun(r.Id)"
                                        disabled="@(_busyId == r.Id)">
                                    Open
                                </button>
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => BeginRename(r)"
                                        disabled="@(_busyId == r.Id)">
                                    Rename
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteRun(r.Id)"
                                        disabled="@(_busyId == r.Id)"
                                        title="Delete this run">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!string.IsNullOrWhiteSpace(_continuationToken))
        {
            <div class="d-flex justify-content-center border-top pt-3 mt-3">
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadMore" disabled="@_loadingMore">
                    @(_loadingMore ? "Loading…" : "Load more")
                </button>
            </div>
        }
    </section>
}

@code {
    private List<AnalysisRunSummary> _runs = new();
    private bool _loading = true;
    private bool _loadingMore;
    private string? _continuationToken;
    private string? _error;
    private string _searchFilter = string.Empty;
    private bool _successOnly;
    private Guid? _busyId;
    private Guid? _editingId;
    private string _editName = string.Empty;

    private List<AnalysisRunSummary> Filtered =>
        _runs
            .Where(r => string.IsNullOrWhiteSpace(_searchFilter)
                        || r.DocumentId.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase)
                        || (r.SessionName?.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(r => !_successOnly || r.Succeeded)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Repo.ListPageAsync(new AnalysisListFilter(Take: 50));
            _runs = page.Items.ToList();
            _continuationToken = page.ContinuationToken;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMore()
    {
        if (_loadingMore || string.IsNullOrWhiteSpace(_continuationToken)) return;
        _loadingMore = true;
        _error = null;
        try
        {
            var page = await Repo.ListPageAsync(
                new AnalysisListFilter(Take: 50),
                _continuationToken);
            _runs.AddRange(page.Items.Where(item => _runs.All(existing => existing.Id != item.Id)));
            _continuationToken = page.ContinuationToken;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task OpenRun(Guid id)
    {
        _busyId = id;
        try
        {
            var run = await Repo.LoadRunAsync(id);
            if (run is null) return;

            Store.DocumentId = run.DocumentId;
            Store.LastRun = run;
            Store.LoadedRunId = id;
            Store.CurrentJobId = null;
            Store.IsRunning = false;
            Store.LastProgress = null;
            // Loaded runs don't have the original CommentResource list available, so
            // clear staged inputs to avoid the Analysis page thinking a re-run is queued.
            Store.Comments = Array.Empty<CommentResource>();
            Store.ClearSelection();
            Navigation.NavigateTo("/analysis");
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task DeleteRun(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this saved analysis run? This cannot be undone.");
        if (!confirmed) return;

        _busyId = id;
        try
        {
            await Repo.DeleteRunAsync(id);
            _runs.RemoveAll(r => r.Id == id);
            // If the deleted run is the one currently loaded, clear the in-memory pointer
            // so the Analysis page doesn't try to persist new chat turns against a dead row.
            if (Store.LoadedRunId == id) Store.LoadedRunId = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private void BeginRename(AnalysisRunSummary run)
    {
        _error = null;
        _editingId = run.Id;
        _editName = run.SessionName ?? string.Empty;
    }

    private void CancelRename()
    {
        _editingId = null;
        _editName = string.Empty;
    }

    private async Task SaveName(AnalysisRunSummary run)
    {
        _busyId = run.Id;
        _error = null;
        try
        {
            var normalized = AnalysisSessionNames.Normalize(_editName);
            await Repo.RenameRunAsync(run.Id, normalized);
            var index = _runs.FindIndex(item => item.Id == run.Id);
            if (index >= 0) _runs[index] = _runs[index] with { SessionName = normalized };
            if (Store.LoadedRunId == run.Id && Store.LastRun is not null)
                Store.LastRun.SessionName = normalized;
            CancelRename();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private static string FormatElapsed(TimeSpan t) =>
        t.TotalSeconds < 60
            ? $"{(int)t.TotalSeconds}s"
            : t.TotalMinutes < 60
                ? $"{(int)t.TotalMinutes}m {(int)(t.TotalSeconds % 60)}s"
                : $"{(int)t.TotalHours}h {(int)(t.TotalMinutes % 60)}m";
}
