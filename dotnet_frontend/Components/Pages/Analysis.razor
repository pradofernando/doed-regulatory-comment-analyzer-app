    private async Task StartChat()
    {
        if (Store.LastRun is null) return;
        _chatStarting = true;
        _chatError = null;
        try
        {
            await Foundry.StartFollowUpThreadAsync(Store.LastRun, SettingsStore.Current, default);
            if (Store.LoadedRunId is Guid id && !string.IsNullOrEmpty(Store.LastRun.FollowUpThreadId))
            {
                try { await Repo.SetFollowUpThreadAsync(id, Store.LastRun.FollowUpThreadId!); }
                catch (Exception ex) { Logger.LogWarning(ex, "Failed to persist follow-up thread ID."); }
            }
        }
        catch (Exception ex)
        {
            _chatError = ex.Message;
        }
        finally
        {
            _chatStarting = false;
        }
    }

    private Task SendCurrentChat()
    {
        if (_chatAsking || string.IsNullOrWhiteSpace(_chatInput)) return Task.CompletedTask;
        var q = _chatInput;
        _chatInput = string.Empty;
        return SendChat(q);
    }

    private async Task SendChat(string question)
    {
        if (Store.LastRun is null || _chatAsking || string.IsNullOrWhiteSpace(question)) return;
        _chatAsking = true;
        _chatError = null;
        var beforeCount = Store.LastRun.FollowUpHistory.Count;
        try
        {
            await Foundry.AskFollowUpAsync(Store.LastRun, question, SettingsStore.Current, default);
            if (Store.LoadedRunId is Guid id)
            {
                // FoundryAnalysisService appends exactly two turns (user + agent); persist both.
                var added = Store.LastRun.FollowUpHistory.Skip(beforeCount).ToList();
                foreach (var t in added)
                {
                    try { await Repo.AppendFollowUpAsync(id, t); }
                    catch (Exception ex) { Logger.LogWarning(ex, "Failed to persist follow-up turn."); }
                }
            }
        }
        catch (Exception ex)
        {
            _chatError = ex.Message;
        }
        finally
        {
            _chatAsking = false;
        }
    }

    private static string BuildTextReport(AnalysisRun run)
    {
        var sb = new StringBuilder();
        var sep = new string('=', 60);
        var thin = new string('-', 60);
        sb.AppendLine(sep);
        sb.AppendLine("REGULATORY COMMENTS — AI ANALYSIS REPORT");
        sb.AppendLine(sep);
        sb.AppendLine($"Document:           {run.DocumentId}");
        sb.AppendLine($"Started:            {run.StartedAt:yyyy-MM-dd HH:mm:ss} UTC");
        sb.AppendLine($"Completed:          {run.CompletedAt:yyyy-MM-dd HH:mm:ss} UTC");
        sb.AppendLine($"Comments analyzed:  {run.TotalComments}");
        sb.AppendLine($"Batch size:         {run.BatchSize}");
        sb.AppendLine();

        var g = run.Grouped;
        if (!string.IsNullOrWhiteSpace(g.OverallSummary))
        {
            sb.AppendLine("OVERALL SUMMARY");
            sb.AppendLine(thin);
            sb.AppendLine(g.OverallSummary);
            sb.AppendLine();
        }
        if (!string.IsNullOrWhiteSpace(g.OverallSentiment))
        {
            sb.AppendLine($"OVERALL SENTIMENT: {g.OverallSentiment}");
            sb.AppendLine();
        }
        if (g.ThemeGroups.Count > 0)
        {
            sb.AppendLine("THEME GROUPS");
            sb.AppendLine(thin);
            int i = 1;
            foreach (var t in g.ThemeGroups.OrderByDescending(x => x.Count))
            {
                sb.AppendLine($"{i}. {t.GroupName}  ({t.Count} comments)");
                if (!string.IsNullOrWhiteSpace(t.GroupDescription)) sb.AppendLine($"   {t.GroupDescription}");
                if (t.StanceDistribution.Count > 0)
                    sb.AppendLine("   Stance:   " + string.Join(" | ", t.StanceDistribution.Select(kv => $"{kv.Key}: {kv.Value}")));
                if (t.SubmissionNumbers.Count > 0)
                    sb.AppendLine("   Subs:     " + string.Join(", ", t.SubmissionNumbers.Take(20).Select(n => $"#{n}")) + (t.SubmissionNumbers.Count > 20 ? ", ..." : ""));
                if (t.CommonArguments.Count > 0)
                {
                    sb.AppendLine("   Key arguments:");
                    foreach (var arg in t.CommonArguments.Take(6)) sb.AppendLine($"     - {arg}");
                }
                sb.AppendLine();
                i++;
            }
        }
        if (g.Patterns.Count > 0)
        {
            sb.AppendLine("KEY PATTERNS");
            sb.AppendLine(thin);
            int i = 1; foreach (var p in g.Patterns) { sb.AppendLine($"{i}. {p}"); i++; }
            sb.AppendLine();
        }
        if (g.Recommendations.Count > 0)
        {
            sb.AppendLine("RECOMMENDATIONS");
            sb.AppendLine(thin);
            int i = 1; foreach (var r in g.Recommendations) { sb.AppendLine($"{i}. {r}"); i++; }
            sb.AppendLine();
        }
        if (!g.ParsedSuccessfully)
        {
            sb.AppendLine("RAW AGENT RESPONSE");
            sb.AppendLine(thin);
            sb.AppendLine(g.RawResponse);
        }
        sb.AppendLine(sep);
        return sb.ToString();
    }
